# Secrets (owner-only local files; names in .env.example)
.env
.env.*
!.env.example
.secrets/
.local/
.vercel

# Source documents for a deck stay local; never committed
docs/context/

# Tooling output
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
playwright-report/
test-results/
gate-results/
*.log
.DS_Store

# Rendered on every build (npm run build / npm run pdf)
public/pdf/

# Agent worktrees and machine-local preview config
.claude/worktrees/
.claude/launch.json
.claude/settings.local.json

# Machine-local parity baselines (feature 003, T310): this machine and the
# placeholder deck only; a copy lives in .local/baselines/.
tests/slides/components.spec.ts-snapshots/
# The J1 build's whole-slide baselines (feature 003, T320), likewise; a copy
# lives in .local/baselines/j1-slides/.
tests/slides/deck.spec.ts-snapshots/
# Scratch slide folders the slide specs write and remove (tests/slides/scratch.ts).
tests/slides/.scratch/
