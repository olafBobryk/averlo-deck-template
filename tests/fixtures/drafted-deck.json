[
  {
    "run": "1: Averlo brand",
    "brand": {
      "kind": "averlo"
    },
    "langs": ["en"],
    "slides": [
      {
        "id": "title",
        "kind": "title",
        "title": {
          "en": "Notes from the launch planning meeting"
        }
      },
      {
        "id": "why",
        "kind": "slide",
        "section": {
          "en": "Why we are launching now"
        },
        "title": {
          "en": "Why we are launching now"
        }
      },
      {
        "id": "release",
        "kind": "slide",
        "section": {
          "en": "What the first release does"
        },
        "title": {
          "en": "What the first release does"
        }
      },
      {
