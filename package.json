{
  "name": "averlo-deck-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/render-pdf.mjs",
    "start": "next start --hostname 127.0.0.1",
    "pdf": "node scripts/render-pdf.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:smoke": "playwright test",
    "test:strips": "playwright test --config playwright.strips.config.ts",
    "test:tools": "node --test \"tests/tools/*_test.mjs\"",
    "check:ports": "node scripts/check-ports.mjs",
    "scan:public": "node scripts/scan-public.mjs",
    "gate": "node scripts/gate.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "motion": "14.7.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@material-symbols/svg-400": "0.48.2",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
