{
  "name": "averlo-deck-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "predev": "node scripts/slides-index.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/slides-index.mjs",
    "build": "next build && node scripts/render-pdf.mjs",
    "start": "next start --hostname 127.0.0.1",
    "pdf": "node scripts/render-pdf.mjs",
    "slides": "node scripts/slides-index.mjs",
    "precheck": "node scripts/slides-index.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "node scripts/slides-index.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:smoke": "playwright test",
    "test:strips": "playwright test --config playwright.strips.config.ts",
    "test:tools": "node --test \"tests/tools/*_test.mjs\"",
    "check:ports": "node scripts/check-ports.mjs",
    "scan:public": "node scripts/scan-public.mjs",
    "presets:doc": "node scripts/presets-doc.mjs",
    "gate": "node scripts/gate.mjs",
    "check:deck": "node scripts/check-deck.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.18.0",
    "motion": "14.7.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  }
}
